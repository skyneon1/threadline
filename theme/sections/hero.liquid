<section class="hero" {% if section.settings.image %}style="background-image:url({{ section.settings.image | image_url: width: 2000 }})"{% endif %}>
  <div class="hero-content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}<a class="btn btn-light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Hero banner","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"New season"},{"type":"text","id":"heading","label":"Heading","default":"Wear it your way"},{"type":"textarea","id":"text","label":"Text","default":"Fresh essentials for every day — tees, denim, outerwear and more."},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero banner"}]}
{% endschema %}
