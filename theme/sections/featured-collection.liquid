{% assign c = section.settings.collection | default: collections.all %}
<section class="container section">
  <div class="section-head"><h2>{{ section.settings.heading }}</h2><a href="{{ c.url }}">View all →</a></div>
  <div class="product-grid">
    {% for product in c.products limit: section.settings.limit %}
      {% render 'product-card', product: product %}
    {% else %}
      {% for i in (1..4) %}<div class="product-card">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}<p>Example product</p></div>{% endfor %}
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"New arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
