<section class="container section">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search">
    <input type="hidden" name="type" value="product">
    <button class="btn">Search</button>
  </form>
  {% if search.performed %}
    <p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
    <div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>
  {% endif %}
</section>
{% schema %}
{"name":"Search","settings":[]}
{% endschema %}
