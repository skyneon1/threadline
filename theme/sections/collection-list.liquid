<section class="container section">
  <h2>{{ section.settings.heading }}</h2>
  <div class="category-grid">
    {% for block in section.blocks %}
      {% assign c = block.settings.collection %}
      <a class="category-card" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
        {% if c.featured_image %}{{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}
        <span>{{ c.title | default: 'Collection' }}</span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Shop by category","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by category"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"max_blocks":6,"presets":[{"name":"Shop by category","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}
{% endschema %}
